[
  {
    "id": "2026-08-10-johnson-ai-ceo-hearings",
    "date": "2026-08-10",
    "addressed_to": "Speaker of the House Mike Johnson",
    "led_by": [
      "Greg Casar",
      "Delia C. Ramirez"
    ],
    "summary": "The letter asks Speaker Johnson to work with the committees of jurisdiction to schedule open hearings immediately at which the chief executives of the largest AI companies answer questions under oath, alongside independent experts. It cites recent incidents in which OpenAI and Anthropic test models hacked other organizations and also raises AI-driven job losses.",
    "url": "https://casar.house.gov/sites/evo-subsites/casar.house.gov/files/evo-media-document/final-letter-to-speaker-johnson-requesting-ai-hearings.pdf",
    "pdf_url": "https://casar.house.gov/sites/evo-subsites/casar.house.gov/files/evo-media-document/final-letter-to-speaker-johnson-requesting-ai-hearings.pdf",
    "quotes": [
      {
        "text": "Advanced AI models pose a clear risk to the safety and security of the American people.",
        "source_url": "https://casar.house.gov/media/press-releases/casar-leads-call-congressional-hearings-ai-ceos"
      },
      {
        "text": "They are serious in and of themselves, and they may be the canary in the coal mine warning of much more serious problems if these models continue to advance without regulation.",
        "source_url": "https://casar.house.gov/sites/evo-subsites/casar.house.gov/files/evo-media-document/final-letter-to-speaker-johnson-requesting-ai-hearings.pdf"
      },
      {
        "text": "Congress must act before such an incident leads to a much larger catastrophe.",
        "source_url": "https://casar.house.gov/sites/evo-subsites/casar.house.gov/files/evo-media-document/final-letter-to-speaker-johnson-requesting-ai-hearings.pdf"
      },
      {
        "text": "Unfortunately, Congress has so far completely failed to respond to the threats posed by AI development. That must change.",
        "source_url": "https://casar.house.gov/media/press-releases/casar-leads-call-congressional-hearings-ai-ceos"
      }
    ],
